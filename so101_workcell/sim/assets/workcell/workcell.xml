<mujoco model="so101_workcell_scene">
  <include file="so101_workcell.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.45 0.6" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <texture type="2d" name="table_tex" builtin="checker" mark="edge" rgb1="0.85 0.82 0.75" rgb2="0.78 0.75 0.68" markrgb="0.6 0.6 0.6" width="300" height="300"/>
    <material name="table_mat" texture="table_tex" texuniform="true" texrepeat="8 8" reflectance="0.05"/>
    <material name="bin_left_mat" rgba="0.25 0.35 0.75 1"/>
    <material name="bin_right_mat" rgba="0.75 0.35 0.25 1"/>
    <material name="cube_red" rgba="0.9 0.15 0.15 1"/>
    <material name="cube_green" rgba="0.15 0.75 0.2 1"/>
    <material name="cube_blue" rgba="0.15 0.3 0.9 1"/>
    <material name="cube_yellow" rgba="0.95 0.85 0.1 1"/>
  </asset>

  <default>
    <default class="cube">
      <geom type="box" size="0.0125 0.0125 0.0125" mass="0.02" condim="4" friction="1.2 0.02 0.001"
            solref="0.01 1" solimp="0.95 0.99 0.001" group="1"/>
    </default>
    <default class="bin">
      <geom type="box" condim="3" friction="0.8 0.01 0.001" group="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="false" diffuse="0.8 0.8 0.8" castshadow="true"/>
    <light pos="-0.5 0.5 1.0" dir="0.5 -0.5 -1" directional="true" diffuse="0.3 0.3 0.3" castshadow="false"/>

    <!-- The arm is bolted to the table surface; the table top is the z=0 plane. -->
    <geom name="table" type="plane" size="0.6 0.5 0.05" material="table_mat" condim="4" friction="1.0 0.02 0.001"/>

    <!-- Cameras -->
    <camera name="overhead" pos="0.25 0 0.75" xyaxes="0 -1 0 1 0 0" fovy="55"/>
    <camera name="front" pos="0.95 0 0.45" xyaxes="0 1 0 -0.45 0 1" fovy="45"/>
    <camera name="side" pos="0.3 -0.8 0.4" xyaxes="1 0 0 0 0.45 1" fovy="45"/>

    <!-- Bins: shallow trays with 15 mm walls -->
    <body name="bin_left" pos="0.17 0.16 0">
      <geom class="bin" name="bin_left_floor" pos="0 0 0.0025" size="0.045 0.045 0.0025" material="bin_left_mat"/>
      <geom class="bin" pos="0 0.045 0.0125" size="0.045 0.003 0.0125" material="bin_left_mat"/>
      <geom class="bin" pos="0 -0.045 0.0125" size="0.045 0.003 0.0125" material="bin_left_mat"/>
      <geom class="bin" pos="0.045 0 0.0125" size="0.003 0.045 0.0125" material="bin_left_mat"/>
      <geom class="bin" pos="-0.045 0 0.0125" size="0.003 0.045 0.0125" material="bin_left_mat"/>
      <site name="bin_left_center" pos="0 0 0.03" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="bin_right" pos="0.17 -0.16 0">
      <geom class="bin" name="bin_right_floor" pos="0 0 0.0025" size="0.045 0.045 0.0025" material="bin_right_mat"/>
      <geom class="bin" pos="0 0.045 0.0125" size="0.045 0.003 0.0125" material="bin_right_mat"/>
      <geom class="bin" pos="0 -0.045 0.0125" size="0.045 0.003 0.0125" material="bin_right_mat"/>
      <geom class="bin" pos="0.045 0 0.0125" size="0.003 0.045 0.0125" material="bin_right_mat"/>
      <geom class="bin" pos="-0.045 0 0.0125" size="0.003 0.045 0.0125" material="bin_right_mat"/>
      <site name="bin_right_center" pos="0 0 0.03" size="0.003" rgba="0 0 0 0"/>
    </body>

    <!-- Cubes: free bodies, repositioned by the scene randomizer -->
    <body name="cube_red" pos="0.25 0.0 0.0125">
      <freejoint name="cube_red_joint"/>
      <geom class="cube" name="cube_red_geom" material="cube_red"/>
    </body>
    <body name="cube_green" pos="0.30 0.06 0.0125">
      <freejoint name="cube_green_joint"/>
      <geom class="cube" name="cube_green_geom" material="cube_green"/>
    </body>
    <body name="cube_blue" pos="0.20 -0.06 0.0125">
      <freejoint name="cube_blue_joint"/>
      <geom class="cube" name="cube_blue_geom" material="cube_blue"/>
    </body>
  </worldbody>
</mujoco>
